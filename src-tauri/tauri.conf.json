{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mellow Minutes",
  "version": "1.0.0",
  "identifier": "com.mellowminutes.pomodoro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mellow Minutes",
        "width": 320,
        "height": 384,
        "minWidth": 320,
        "minHeight": 384,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "alwaysOnTop": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
